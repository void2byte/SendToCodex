{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open Codex Multitool Extension Host",
      "type": "shell",
      "command": "code",
      "args": [
        "--new-window",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--enable-proposed-api",
        "screph.codex-terminal-recorder",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    }
  ]
}
